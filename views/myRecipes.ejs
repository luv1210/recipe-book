<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>My Recipes - Chef's Table</title>
  <link href="/css/style.css" rel="stylesheet">
</head>
<body>
  <%- include('partials/navbar') %>
  <div class="container">
    <h1 style="color: var(--primary-color);">My Culinary Creations</h1>
    <div class="recipe-grid">
      <% if (recipes.length === 0) { %>
        <p>You haven't shared any recipes yet. <a href="/recipes/new">Share your first one!</a></p>
      <% } else { %>
        <% recipes.forEach(function(recipe) { %>
          <div class="recipe-card">
            <% if (recipe.image) { %>
              <img src="<%= recipe.image %>" alt="<%= recipe.title %>" style="width: 100%; height: 200px; object-fit: cover;">
            <% } %>
            <div class="recipe-card-content">
              <h3><%= recipe.title %></h3>
              <p><%= recipe.instructions.substring(0, 100) %>...</p>
              <div style="display: flex; gap: 1rem; align-items: center;">
                <a class="btn btn-primary" href="/recipes/<%= recipe._id %>">View</a>
                <form action="/recipes/<%= recipe._id %>/delete" method="POST" style="margin: 0;">
                  <button class="btn" type="submit" style="background-color: #dc3545; color: white;">Delete</button>
                </form>
              </div>
            </div>
          </div>
        <% }) %>
      <% } %>
    </div>
  </div>
</body>
</html>
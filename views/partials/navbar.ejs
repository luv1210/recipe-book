<header id="mainHeader">
  <nav>
    <div class="logo">
      <a href="/">Chef's Table</a>
    </div>
    <div>
      <a href="/" class="<%= typeof page !== 'undefined' && page === 'recipes' ? 'active' : '' %>">Recipes</a>
      <% if (user) { %>
        <a href="/my-recipes" class="<%= typeof page !== 'undefined' && page === 'my-recipes' ? 'active' : '' %>">My Recipes</a>
        <a href="/recipes/new" class="<%= typeof page !== 'undefined' && page === 'new-recipe' ? 'active' : '' %>">New Recipe</a>
        <a href="/logout" style="border: 1px solid var(--primary-color); border-radius: var(--radius-sm); font-size: 0.85rem; padding: 0.4rem 0.8rem;">Logout (<%= user.username %>)</a>
      <% } else { %>
        <a href="/login" class="<%= typeof page !== 'undefined' && page === 'login' ? 'active' : '' %>">Login</a>
        <a href="/register" class="btn-register">Register</a>
      <% } %>
    </div>
  </nav>
</header>

<script>
  window.addEventListener('scroll', () => {
    const header = document.getElementById('mainHeader');
    if (window.scrollY > 50) {
      header.style.background = 'rgba(255, 255, 255, 0.95)';
      header.style.boxShadow = 'var(--shadow-md)';
    } else {
      header.style.background = 'rgba(255, 255, 255, 0.8)';
      header.style.boxShadow = 'none';
    }
  });
</script>
